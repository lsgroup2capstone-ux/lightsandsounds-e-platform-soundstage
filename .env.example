# Supabase Dashboard > Connect
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only admin setup: npm run admin:create creates a new Supabase Auth user.
# These values alone do not create an account or change its password.
SUPABASE_SECRET_KEY=
# Legacy Supabase Gmail OTP delivery: see docs/gmail-email-otp.md.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
SUPABASE_SEND_EMAIL_HOOK_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Legacy Supabase signup SMS only. Follow docs/philsms-setup.md once, then run npm run sms:check.
# Both values are server-only. Sender must be approved for your PhilSMS account.
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=
# Local signup-phone demo: code 123456, no SMS sent. Always disabled in production.
ENABLE_DEMO_OTP=false
# Optional legacy Supabase SMS hook only; not required for signup OTP.
# SUPABASE_SEND_SMS_HOOK_SECRET=

# Clerk handles client/provider email signup, login, email OTP recovery and Google. Keep the secret key server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/clerk/continue
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/clerk/signup

# Server-only: Connect > Session pooler, with a URL-encoded database password.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# Optional trusted CA certificate in PEM format (escaped newlines supported).
# SUPABASE_DB_CA=

# Existing checkout is a simulation; no payment processor is connected.
# Explicitly enable only for demo/test use. Demo proceeds cannot be withdrawn.
ENABLE_DEMO_PAYMENTS=false
